# Full list at https://github.com/artefactual/archivematica/tree/stable/1.17.x/src/dashboard/install#parameter-list
FORWARDED_ALLOW_IPS="*"
AM_GUNICORN_ACCESSLOG="/dev/null"
DJANGO_SETTINGS_MODULE="archivematica.dashboard.settings.local"
ARCHIVEMATICA_DASHBOARD_DASHBOARD_GEARMAN_SERVER="gearmand:4730"
ARCHIVEMATICA_DASHBOARD_DASHBOARD_ELASTICSEARCH_SERVER="http://elasticsearch:9200"
ARCHIVEMATICA_DASHBOARD_DASHBOARD_PROMETHEUS_ENABLED="1"
ARCHIVEMATICA_DASHBOARD_CLIENT_USER="${ARCHIVEMATICA_DB_USER:-archivematica}"
ARCHIVEMATICA_DASHBOARD_CLIENT_PASSWORD="${ARCHIVEMATICA_DB_PASSWORD:-demo}"
ARCHIVEMATICA_DASHBOARD_CLIENT_HOST="mysql"
ARCHIVEMATICA_DASHBOARD_CLIENT_DATABASE="${ARCHIVEMATICA_MCP_DB_NAME:-MCP}"
ARCHIVEMATICA_DASHBOARD_SEARCH_ENABLED="${AM_SEARCH_ENABLED:-false}"
ARCHIVEMATICA_DASHBOARD_DASHBOARD_AUDIT_LOG_MIDDLEWARE="true"
ARCHIVEMATICA_DASHBOARD_DASHBOARD_SESSION_COOKIE_SECURE="false"
ARCHIVEMATICA_DASHBOARD_DASHBOARD_CSRF_COOKIE_SECURE="false"
