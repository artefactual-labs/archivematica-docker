# Full list at https://github.com/artefactual/archivematica/tree/stable/1.17.x/src/MCPServer/install#parameter-list
DJANGO_SECRET_KEY="${AM_DJANGO_SECRET_KEY:-12345}"
DJANGO_SETTINGS_MODULE="archivematica.MCPServer.settings.common"
ARCHIVEMATICA_MCPSERVER_CLIENT_USER="${ARCHIVEMATICA_DB_USER:-archivematica}"
ARCHIVEMATICA_MCPSERVER_CLIENT_PASSWORD="${ARCHIVEMATICA_DB_PASSWORD:-demo}"
ARCHIVEMATICA_MCPSERVER_CLIENT_HOST="mysql"
ARCHIVEMATICA_MCPSERVER_CLIENT_DATABASE="${ARCHIVEMATICA_MCP_DB_NAME:-MCP}"
ARCHIVEMATICA_MCPSERVER_MCPSERVER_MCPARCHIVEMATICASERVER="gearmand:4730"
ARCHIVEMATICA_MCPSERVER_SEARCH_ENABLED="${AM_SEARCH_ENABLED:-false}"
ARCHIVEMATICA_MCPSERVER_MCPSERVER_PROMETHEUS_BIND_PORT="7999"
ARCHIVEMATICA_MCPSERVER_MCPSERVER_PROMETHEUS_BIND_ADDRESS="0.0.0.0"
ARCHIVEMATICA_MCPSERVER_MCPSERVER_BATCH_SIZE=32
