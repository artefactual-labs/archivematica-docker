# Default configuration values . Override them in .env

# Change this and use the result of "id -u"
UID=1000
COMPOSE_PROJECT_NAME=am


# Default users
ARCHIVEMATICA_SS_USER=test
ARCHIVEMATICA_SS_EMAIL=test@test
ARCHIVEMATICA_SS_PASSWORD=test
ARCHIVEMATICA_SS_APIKEY=test

ARCHIVEMATICA_DASHBOARD_USER=test
ARCHIVEMATICA_DASHBOARD_PASSWORD=test
ARCHIVEMATICA_DASHBOARD_APIKEY=test
ARCHIVEMATICA_DASHBOARD_EMAIL=test@test.com

# Organization name and id
ARCHIVEMATICA_DASHBOARD_ORG_NAME=test
ARCHIVEMATICA_DASHBOARD_ORG_ID=test
AM_DJANGO_SECRET_KEY=123

# Databases
DB_ROOT_PASSWORD=t1234
ARCHIVEMATICA_DB_USER=archivematica
ARCHIVEMATICA_MCP_DB_NAME=MCP
ARCHIVEMATICA_SS_DB_NAME=SS
ARCHIVEMATICA_DB_PASSWORD=demo

# Ports
AM_DASHBOARD_PORT=62080
AMSS_PORT=62081

# Enable Archival Storage tab (disabled by default)
COMPOSE_PROFILES=search
AM_SEARCH_ENABLED=true

# Default internal mounts
ARCHIVEMATICA_SS_STAGING=./.storage_service/
ARCHIVEMATICA_SHAREDDIRECTORY=./.sharedDirectory/

# Docker images
AMSS_IMAGE=artefactual/archivematica-storage-service:v0.24.0
AM_DASHBOARD_IMAGE=artefactual/archivematica-dashboard:v1.18.0
AM_MCP_SERVER_IMAGE=artefactual/archivematica-mcp-server:v1.18.0
AM_MCP_CLIENT_IMAGE=artefactual/archivematica-mcp-client:v1.18.0

